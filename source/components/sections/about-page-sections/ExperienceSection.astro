---
import PageTitleH1 from "../../typography/PageTitleH1.astro";
import ImageCarousel from "../../ui/ImageCarousel.astro";
import FirstLevelTextBlock from "../FirstLevelTextBlock.astro";

const {
  firstLevelTextBlockTitleArray = [],
  firstLevelTextBlockDescriptionArray = [],
  experienceValues,
  experienceValuesExplanation,
} = Astro.props;

const cultureCodeSectionTitle = {
  en: "Culture code",
  ru: "Культурный код",
};

const locale = Astro.currentLocale ?? "en";
---

<section class="grid-base col-span-10 px-12 pt-32">
  <!-- Часть страницы с описанием опыта работы на рынке в цифрах -->
  <div class="col-span-4 col-start-1 justify-self-center">
    <div class="flex flex-col space-y-[12px]">
      <FirstLevelTextBlock
        title={firstLevelTextBlockTitleArray[0]}
        description={firstLevelTextBlockDescriptionArray[0]}
      />
    </div>
  </div>
  <div class="col-span-5 col-start-6 border-b border-[rgba(0,0,0,0.2)] pt-6">
    {
      experienceValues.map((numb, index) => (
        <div class="flex justify-between border-t border-[rgba(0,0,0,0.2)] pb-12 pt-12">
          <p class="font-manrope text-[96px] font-normal leading-[84%] tracking-[-3%]">
            {numb}
          </p>
          <p class="font-manrope text-right text-[18px] font-normal leading-[150%] tracking-normal">
            {experienceValuesExplanation[index]}
          </p>
        </div>
      ))
    }
  </div>

  <!-- Часть страницы с описанием опыта сотрудников -->
  <div
    class="col-span-5 col-start-6 mt-[96px]
         justify-self-center sm:mt-[160px] md:mt-[220px] lg:mt-[295px]"
  >
    <div class="flex flex-col space-y-[12px]">
      <FirstLevelTextBlock
        title={firstLevelTextBlockTitleArray[1]}
        description={firstLevelTextBlockDescriptionArray[1]}
      />
    </div>
  </div>
  <div
    class="col-span-10 -mx-12
         mt-[24px] sm:mt-[40px] md:mt-[64px] lg:mt-[102px]"
  >
    <ImageCarousel />
  </div>

  <!-- Часть страницы с описанием вектора сотрудничества -->
  <div
    class="col-span-6 col-start-1 mt-[96px]
         justify-self-center sm:mt-[160px] md:mt-[240px] lg:mt-[344px]"
  >
    <div class="flex flex-col space-y-[12px]">
      <FirstLevelTextBlock
        title={firstLevelTextBlockTitleArray[2]}
        description={firstLevelTextBlockDescriptionArray[2]}
      />
      <FirstLevelTextBlock description={firstLevelTextBlockDescriptionArray[3]} />
    </div>
  </div>

  <PageTitleH1 
  title={cultureCodeSectionTitle[locale]} 
  css="col-span-7 col-start-1 mt-[64px] sm:mt-[128px] md:mt-[200px] lg:mt-[280px] mb-[40px] sm:mb-[56px] md:mb-[72px] lg:mb-[80px]"
  />
</section>
