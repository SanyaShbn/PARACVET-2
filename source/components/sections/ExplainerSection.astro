---
// Здесь использую интерфейс, вообще так чище и правильнее вроде (в остальных компонентах особо не использую).
// Дальше и в остальных компонентах можно определить, когда обсудим, верно ли я их вообще выделил, может что изменим.
// Поэтому уже написанное в коде остальных компонентов пока не трогаю
export interface Props {
  // общие пропсы
  id?: string;
  title?: string;

  // пропсы, если верстаем страницу "Методология" и используем там этот компонент
  description?: string;
  stageResultItems?: string[];

  // пропсы, если верстаем страницу "Услуги" и используем там этот компонент
  categoryArray?: string[];
  categoryDescriptionArray?: string[];

  // пропсы, если верстаем страницу "О компании" и используем там этот компонент
  numericMarkerArray?: string[];
  numericTitleArray?: string[];
  numericDescriptionArray?: string[];
}

import ExplainerSectionTitleH3 from "../typography/ExplainerSectionTitleH3.astro";
import CapabilityCategory from "../typography/services-page-typography/CapabilityCategory.astro";
import CapabilityDescription from "../typography/services-page-typography/CapabilityDescription.astro";

const {
  id,
  title,
  description,
  stageResultItems = [],
  categoryArray = [],
  categoryDescriptionArray = [],
  numericMarkerArray = [],
  numericTitleArray = [],
  numericDescriptionArray = [],
} = Astro.props;

const itemsListTitle = {
  en: "Stage results:",
  ru: "Результаты этапа:",
};

const locale = Astro.currentLocale ?? "en";
---

<!-- Компонент общей пояснительной секции (поэтому пока дал название ExplainerSection). Выделил данную секцию из страниц "Услуги",
 "Методология" и "О компании" (страницы, располагающиеся после заголовков "Наши возможности", "Основной воркфлоу" и 
 "Культурный код" соответственно) -->{
  !title && numericMarkerArray.length > 0 ? (
    // Секция "Культурный код" страницы "О компании"
    <>
      {numericMarkerArray.map((marker, index) => (
        <section
          id={id ? `${id}-${index}` : undefined}
          class="col-span-10 h-[300px] px-12"
        >
          <div class="grid-base border-t border-[rgba(0,0,0,0.2)] pt-[50px]">
            <div class="col-span-1 col-start-1 text-[64px] font-medium leading-[124%] tracking-[-1.28px] text-[#121315] opacity-20">
              {marker}
            </div>

            <h3 class="col-span-3 col-start-2 text-[36px] font-medium leading-[150%] tracking-[-0.792px] text-[rgba(0,0,0,0.80)]">
              {numericTitleArray[index]}
            </h3>

            <p class="col-span-5 col-start-6 text-[16px] font-normal leading-[150%] tracking-[-0.352px] text-[rgba(0,0,0,0.80)]">
              {numericDescriptionArray[index]}
            </p>
          </div>
        </section>
      ))}
    </>
  ) : (
    // Секция "Наши возможности"/"Основной воркфлоу" страниц "Услуги"/"Методология"
    <section
      id={id}
      class={`${
        description ? "" : "grid-base border-t border-[rgba(0,0,0,0.2)]"
      } col-span-10 h-auto px-12 pb-[90px]`}
    >
      {/* Секция "Основной воркфлоу" */}
      {description && (
        <div class="grid-base border-t border-black">
          {title && (
            <div class="col-span-3 mt-[42px]">
              <ExplainerSectionTitleH3>{title}</ExplainerSectionTitleH3>
            </div>
          )}
          <div class="col-span-3 col-start-6 gap-x-[6px] pt-[10px]">
            <p
              class={`${
                stageResultItems.length > 0 ? "mb-0" : "mb-[215px]"
              } mt-[75px] font-normal leading-[150%] tracking-[-2.2%] opacity-80`}
            >
              {description}
            </p>

            {stageResultItems.length > 0 && (
              <div class="mt-[75px]">
                <p class="font-inter leading-[150%] tracking-[-1.1%] text-[#1E1E1E]">
                  {itemsListTitle[locale]}
                </p>
                <ul class="mt-[24px] list-disc space-y-1 pl-[25px] font-normal leading-[150%] tracking-[-2.2%] opacity-80">
                  {stageResultItems.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      )}

      {/* Секция "Наши возможности" */}
      {categoryArray.length > 0 && categoryDescriptionArray.length > 0 && (
        <div class="col-span-3 mt-[42px]">
          <ExplainerSectionTitleH3>{title}</ExplainerSectionTitleH3>
        </div>
        <div class="col-span-5 col-start-5 mt-[54px] gap-x-[6px]">
          {categoryArray.map((cat, index) => (
            <div class="flex flex-col space-y-2 pb-[62px]">
              <CapabilityCategory>{cat}</CapabilityCategory>
              <CapabilityDescription>
                {categoryDescriptionArray[index]}
              </CapabilityDescription>
            </div>
          ))}
        </div>
      )}
    </section>
  )
}
