---
import SectionTitleH2 from "../../typography/SectionTitleH2.astro";
import MethodCircle from "../../ui/MethodCircle.astro";

const locale = Astro.currentLocale ?? "en";

const circleData = [
  {
    position: "left-[-2%] top-[10%]",
    label: {
      en: "Vision",
      ru: "Видение",
    },
    labelPosition: "absolute top-[73%] left-[34%]",
    description: {
      ru: "Собираем пазл — соединяем ваши цели, корпоративную культуру и имидж в одну систему.",
      en: "We assemble the puzzle — we connect your goals, corporate culture and image into one system.",
    },
  },
  {
    position: "left-[50%] -translate-x-[50%] top-[10%]",
    label: {
      en: "Brand",
      ru: "Бренд",
    },
    labelPosition: "absolute top-[73%] left-[38%]",
    description: {
      ru: "Убираем противоречия — когда отдел продаж говорит то же, что HR, а сайт не конфликтует с рекламой.",
      en: "We eliminate contradictions — when the sales department says the same thing as HR, and the website does not conflict with advertising.",
    },
  },
  {
    position: "right-[-2%] top-[10%]",
    label: {
      en: ["Values", "& Culture"],
      ru: ["Ценности,", "Культура"],
    },
    labelPosition: "absolute top-[73%] left-[39%]",
    description: {
      ru: "Запускаем эффект домино — решения на уровне стратегии превращаются в конкретные шаги для каждого отдела.",
      en: "We start a domino effect — decisions at the strategic level turn into specific steps for each department.",
    },
  },
];

const workflowSectionTitle = {
  en: "Main workflow",
  ru: "Основной воркфлоу",
};
---

<section class="relative col-span-10 h-[200vh] overflow-hidden">
  {
    circleData.map(({ position, label, labelPosition, description }) => (
      <div class={`absolute ${position}`}>
        <MethodCircle label={label[locale]} labelPosition={labelPosition} />
        <p class="absolute left-[20%] top-[126%] w-[60%] text-[18px] font-normal leading-[150%] tracking-[-0.396px] text-[rgba(0,0,0,0.80)]">
          {description[locale]}
        </p>
      </div>
    ))
  }

  <SectionTitleH2
    title={workflowSectionTitle[locale]}
    css={`absolute bottom-[6%] px-12`}
  />
</section>
