---
import navigation from "../../data/Navigation";
const locale: string = Astro.currentLocale as string;

const Path = Astro.url.pathname;
const PageSlug = Path.slice(4);

const { css } = Astro.props;
---

<nav class:list={css}>
  <ul class="w-full space-y-[14px] text-right">
    {
      Object.entries(navigation[locale]).map(([item, name]) => (
        <li class="relative text-sm uppercase ">
          <a
            href={`/${locale}/${item}/`}
            class:list={[
              "relative inline-block transition-[font-weight] duration-300",
              PageSlug === item + "/" || PageSlug === name + "/"
                ? [
                    "font-bold",
                    "text-neutral-950",
                    "w-fit",
                    "border-b-[2px]",
                    "border-black",
                    "opacity-80",
                  ]
                : [
                    "before:absolute",
                    "before:bottom-0",
                    "before:right-0",
                    "before:h-[2px]",
                    "before:w-0",
                    "before:bg-[#121315]",
                    "before:transition-all",
                    "before:duration-300",
                    "hover:before:w-full",
                    "hover:before:right-0",
                    "hover:before:left-auto",
                    "hover:font-bold",
                    "hover:text-neutral-950",
                    "hover:opacity-80",
                  ],
            ]}
          >
            {name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script></script>
