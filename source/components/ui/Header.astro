<!-- Вариант просто с флексами -->
<header
  class="flex w-full items-start justify-between px-[12px] pb-0 pt-[12px]"
>
  <Logo css="w-[12%] h-[28px]" />
  <div class="flex w-[60%] shrink-0 items-start justify-end gap-[41%]">
    <a
      href="/contact"
      class="font-golos relative inline-block text-[18px] font-normal text-neutral-950 opacity-80
         before:absolute before:bottom-0 before:left-0 before:h-[2px] before:w-0
         before:bg-black before:transition-all before:duration-300
         hover:before:w-full"
    >
      Lets Talk
    </a>
    <LangTumbler />
  </div>
  <Navigation
    css="flex flex-col w-[16%] px-0 pt-[4px] pb-[10px] items-end shrink-0"
  />
</header>
