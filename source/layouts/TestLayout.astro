---
import type { GetStaticPaths } from "astro";
import { locales } from "../utils/i18n.config";
import "../css/locomotive-scroll.css";

export const getStaticPaths = (() => {
  return locales.map((locale) => {
    return { params: { locale } };
  });
}) satisfies GetStaticPaths;

const locale = Astro.currentLocale;

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <section class="spacer"></section>

    <section class="text-container">
      <h1 class="animated-text">
        Мы не пионеры — мы опытные практики, прошедшие школу реальных проектов. Наша цель — максимально эффективно применять накопленный опыт.  Мы не усложняем, не подменяем задачи клиента креативными экспериментами или личными амбициями. Мы решаем конкретные задачи, успех которых  определяет нас, как проверенных профессианалов и надежных партнеров.
      </h1>
    </section>

    <section class="spacer"></section>

    <script src="../scripts/locomotive-scroll.js"></script>
  </body>

  <style>
    body {
      margin: 0;
      font-family: sans-serif;
      background: #fff;
      color: #000;
    }

    .spacer {
      height: 100vh;
    }

    .text-container {
      padding: 100px 20px;
      max-width: 800px;
      margin: 0 auto;
    }

    .animated-text {
      font-size: 2rem;
      line-height: 1.5;
      text-align: center;
    }

    /* Начальные стили */
    .char {
      transition:
        color 0.3s,
        text-decoration 0.3s;
      color: inherit;
      text-decoration: none;
    }
  </style>
</html>
